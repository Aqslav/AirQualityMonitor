        <ShellContent Title="Клієнт" Route="client" ContentTemplate="{DataTemplate views:ClientPage}" />
        <ShellContent Title="Адмін" Route="admin" ContentTemplate="{DataTemplate views:AdminPage}" />
    </TabBar>

</Shell>
